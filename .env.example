# MediVault Environment Variables Configuration Template
NODE_ENV=development
PORT=3000

# PostgreSQL Connection Configuration
# Option A: Full Connection URL
DATABASE_URL=postgresql://medivault_app:medivault_secret@localhost:5432/medivault

# Option B: Individual Connection Parameters (Fallback if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=medivault
PGUSER=medivault_app
PGPASSWORD=medivault_secret

# PostgreSQL Connection Pool Tuning Parameters
# Tune DATABASE_POOL_MAX based on target deployment server RAM and max database connections
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=5000

# Redis Cache Configuration
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true
REDIS_CACHE_TTL=3600

# Authentication Security
JWT_SECRET=medivault_secret_jwt_key_2026
